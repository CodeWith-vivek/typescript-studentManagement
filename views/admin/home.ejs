<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
       background: url('/assets/images/adminhome.jpg') no-repeat center center fixed;
       background-size: cover;
       min-height: 100vh;
      display: flex;
       justify-content: center;
        animation: gradientAnimation 10s ease infinite;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      overflow: hidden;
    }

    .gradient-bg {
        background: rgb(41 39 39 / 29%);
        backdrop-filter: blur(10px);
       background: rgb(41 39 39 / 29%);
    }

    .table-container {
      background: rgb(74 67 67 / 13%);
        box-shadow: 0 8px 32px rgba(31, 38, 135, 0.2);
        backdrop-filter: blur(10px);
        border: 1px solid rgb(0 0 0 / 30%);
        transition: all 0.3s ease-in-out;
        border-radius: 1rem;
    }

    .table-container:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 40px rgba(31, 38, 135, 0.3);
    }

    .table-header {
        background: linear-gradient(135deg, #0c0414 0%, #000000 100%);
        border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    }

    .action-button {
        transition: all 0.3s ease-in-out;
    }

    .action-button:hover {
        transform: translateY(-2px);
    }

    .table-row {
        background: rgba(255, 255, 255, 0.1);
        transition: all 0.3s ease-in-out;
    }

    .table-row:hover {
        background: rgba(255, 255, 255, 0.2);
    }

    th,
    td {
        color: #ffffff;
    }

    .table-head {
        background: rgba(255, 255, 255, 0.1);
        border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    }
     .swal2-popup {
    backdrop-filter: blur(10px) !important;
    background: rgba(255, 255, 255, 0.15) !important;
    border: 1px solid rgba(255, 255, 255, 0.3) !important;
    color: #ffffff !important;
  }

  .swal2-title,
  .swal2-content {
    color: #ffffff !important;
  }

  .swal2-confirm,
  .swal2-cancel {
    border-radius: 12px !important;
    padding: 0.75rem 1.5rem !important;
    font-weight: 600 !important;
  }

  .swal2-confirm {
    background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%) !important;
    border: none !important;
  }

  .swal2-confirm:hover {
    background: linear-gradient(135deg, #5a0fb0 0%, #1e68e0 100%) !important;
  }

  .swal2-cancel {
    background: linear-gradient(135deg, #d33 0%, #b00 100%) !important;
    border: none !important;
  }

  .swal2-cancel:hover {
    background: linear-gradient(135deg, #b00 0%, #900 100%) !important;
  }
</style>
</head>
<body class="bg-gray-100 min-h-screen flex flex-col">
    <script>
        var successMessage = '<%= success_msg %>';
        var errorMessage = '<%= error_msg %>';

        if (successMessage) {
            Swal.fire({
                toast: true,
                icon: 'success',
                title: successMessage,
                position: 'top',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer);
                    toast.addEventListener('mouseleave', Swal.resumeTimer);
                }
            });
        }
        if (errorMessage) {
            Swal.fire({
                toast: true,
                icon: 'warning',
                title: errorMessage,
                position: 'top',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer);
                    toast.addEventListener('mouseleave', Swal.resumeTimer);
                }
            });
        }

        function confirmDelete(id) {
            Swal.fire({
                title: "Are you sure?",
                text: "Do you really want to delete this record?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, delete it!",
                 customClass: {
                    confirmButton: 'btn btn-primary btn-custom',
                    cancelButton: 'btn btn-danger btn-custom',
                    popup: 'glassmorphism-popup'
                },
                buttonsStyling: false,
                background: 'rgba(255, 255, 255, 0.25)',
                backdrop: `rgba(0, 0, 0, 0.4)`,
                color: '#ffffff'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = `/admin/delete/${id}`;
                }
            });
        }

        function confirmLogout() {
            Swal.fire({
                title: "Are you sure?",
                text: "Do you really want to log out?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, log out!"
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = `/admin/logout`;
                }
            });
        }
    </script>

    <nav class="gradient-bg shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center py-6">
                <h1 class="text-3xl font-bold text-white">Admin Dashboard</h1>
                <button 
                    onclick="confirmLogout()" 
                    class="bg-grey-500 hover:bg-black-600 text-white font-bold py-2 px-4 rounded-full transition duration-300 ease-in-out transform hover:-translate-y-1 hover:scale-110">
                    <i class="fas fa-sign-out-alt mr-2"></i> Logout
                </button>
            </div>
        </div>
    </nav>

<main class="flex-grow container mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="rounded-lg overflow-hidden table-container">
        <div class="px-6 py-4 table-header border-b border-gray-200">
            <h2 class="text-xl font-semibold text-white">Student List</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="table-head">
                    <tr>
                        <th scope="col"
                            class="px-6 py-3 text-left text-xs font-medium text-white-500 uppercase tracking-wider">Name
                        </th>
                        <th scope="col"
                            class="px-6 py-3 text-left text-xs font-medium text-white-500 uppercase tracking-wider">Email
                        </th>
                        <th scope="col"
                            class="px-6 py-3 text-left text-xs font-medium text-white-500 uppercase tracking-wider">Class
                        </th>
                        <th scope="col"
                            class="px-6 py-3 text-left text-xs font-medium text-white-500 uppercase tracking-wider">Role
                            No</th>
                        <th scope="col"
                            class="px-6 py-3 text-left text-xs font-medium text-white-500 uppercase tracking-wider">
                            Registration Date</th>
                        <th scope="col"
                            class="px-6 py-3 text-left text-xs font-medium text-white-500 uppercase tracking-wider">
                            Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    <% result.forEach(student=> { %>
                        <tr class="table-row">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-white">
                                    <%= student.name %>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-white">
                                    <%= student.email %>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-white">
                                    <%= student.class %>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-white">
                                    <%= student.roleno %>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-white">
                                    <%= new Date(student.createdAt).toLocaleDateString() %>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                <a href="/admin/edit/<%= student.email %>"
                                    class="text-blue-600 hover:text-indigo-100 mr-3 action-button inline-block">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <button onclick="confirmDelete('<%= student.email %>')"
                                    class="text-red-700 hover:text-red-100 action-button inline-block">
                                    <i class="fas fa-trash-alt"></i> Delete
                                </button>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</main>

    <footer class="gradient-bg text-white py-4 mt-8">
        <div class="container mx-auto px-4 text-center">
            <p>&copy; <%= new Date().getFullYear() %> Admin Dashboard. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>