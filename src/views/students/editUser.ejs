<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit User Data</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
  <style>
    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: url('/assets/images/studentedit.jpg') no-repeat center center fixed;
      background-size: cover;
      animation: gradientAnimation 10s ease infinite;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      overflow: hidden;
    }

    .form-container {
      background: rgb(50 27 27 / 43%);
      border-radius: 20px;
      padding: 40px;
      box-shadow: 0 8px 32px rgba(31, 38, 135, 0.2);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.3);
      transition: all 0.3s ease-in-out;
    }

    .form-container:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 40px rgba(31, 38, 135, 0.3);
    }

    .form-title {
      margin-bottom: 30px;
      text-align: center;
      font-weight: bold;
      color: #ffffff;
      font-size: 2rem;
      text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
    }

    .form-label {
      font-weight: 600;
      color: #ffffff;
      margin-bottom: 0.5rem;
    }

    .form-control {
      border-radius: 10px;
      padding: 12px;
      border: 1px solid rgba(255, 255, 255, 0.3);
      background: rgba(255, 255, 255, 0.2);
      color: #ffffff;
      transition: all 0.3s ease;
    }

    .form-control:focus {
      border-color: #9d9d9b;
      box-shadow: 0 0 0 0.2rem rgba(188, 186, 189, 0.895);
      background: rgba(255, 255, 255, 0.3);
    }

    .form-control::placeholder {
      color: rgba(255, 255, 255, 0.7);
    }

    .btn-custom {
      background: linear-gradient(135deg, #6e4010 0%, #151617 100%);
      color: #fff;
      border: none;
      border-radius: 10px;
      padding: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      transition: all 0.3s ease;
    }

    .btn-custom:hover {
      transform: translateY(-3px);
      box-shadow: 0 7px 14px rgba(0, 0, 0, 0.3);
      background: linear-gradient(135deg, #734b20 0%, #303133 100%);
    }

    .error-message {
      color: #ff6b6b;
      font-size: 0.875rem;
      margin-top: 0.25rem;
    }

    .input-group-text {
      background: rgba(255, 255, 255, 0.2);
      border: 1px solid rgba(255, 255, 255, 0.3);
      border-right: none;
      color: #ffffff;
    }

    .password-toggle {
      cursor: pointer;
      background: rgba(255, 255, 255, 0.2);
      border: 1px solid rgba(255, 255, 255, 0.3);
      border-left: none;
      color: #ffffff;
    }

    .password-strength {
      margin-top: 5px;
      font-size: 0.8rem;
    }

    .password-requirements {
      margin-top: 5px;
      font-size: 0.75rem;
      color: rgba(255, 255, 255, 0.8);
    }

    .requirement {
      display: flex;
      align-items: center;
      margin-bottom: 3px;
    }

    .requirement i {
      margin-right: 5px;
      font-size: 0.6rem;
    }

    .valid {
      color: #4CAF50;
    }

    .invalid {
      color: #f44336;
    }
  </style>
</head>

<body>

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-6">
        <div class="form-container">
          <h2 class="form-title">Edit User Data</h2>
          <form id="edit-user-form" action="/edituser" method="POST" onsubmit="validateEditForm(event)">
            <div class="mb-4">
              <label for="name" class="form-label">Name</label>
              <div class="input-group">
                <span class="input-group-text"><i class="fas fa-user"></i></span>
                <input type="text" id="name" name="name" class="form-control" placeholder="Name (read-only)"
                  value="<%= userData ? userData.name : '' %>" readonly>
              </div>
            </div>

            <div class="mb-4">
              <label for="class" class="form-label">Class</label>
              <div class="input-group">
                <span class="input-group-text"><i class="fas fa-graduation-cap"></i></span>
                <input type="number" id="class" name="class" class="form-control" placeholder="Class (read-only)"
                  value="<%= userData ? userData.class : '' %>" readonly>
              </div>
            </div>

            <div class="mb-4">
              <label for="password" class="form-label">Current Password / New Password</label>
              <div class="input-group">
                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                <input type="password" id="password" name="password" class="form-control"
                  placeholder="Enter new password" required oninput="validatePassword()">
                <span class="input-group-text password-toggle" onclick="togglePasswordVisibility()">
                  <i class="fas fa-eye"></i>
                </span>
              </div>
              <div id="password-strength" class="password-strength"></div>
              <div class="password-requirements">
                <div class="requirement"><i id="length-icon" class="fas fa-circle"></i> Minimum 8 characters</div>
                <div class="requirement"><i id="uppercase-icon" class="fas fa-circle"></i> At least one uppercase letter
                </div>
                <div class="requirement"><i id="lowercase-icon" class="fas fa-circle"></i> At least one lowercase letter
                </div>
                <div class="requirement"><i id="number-icon" class="fas fa-circle"></i> At least one number</div>
                <div class="requirement"><i id="special-icon" class="fas fa-circle"></i> At least one special character
                </div>
              </div>
            </div>

          <div class="mb-4">
            <label for="roleno" class="form-label">Role Number</label>
            <div class="input-group">
              <span class="input-group-text"><i class="fas fa-id-badge"></i></span>
              <input type="number" id="roleno" name="roleno" class="form-control" placeholder="Enter your role number (1-50)"
                value="<%= userData ? userData.roleno : '' %>" min="1" max="50" oninput="validateRollNo()" required>
            </div>
            <div id="rollno-error" class="error-message"></div>
          </div>

            <div class="d-grid">
              <button type="submit" class="btn btn-custom">
                <i class="fas fa-save me-2"></i>Save Changes
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script>
    function togglePasswordVisibility() {
      const passwordInput = document.getElementById('password');
      const toggleIcon = document.querySelector('.password-toggle i');

      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        toggleIcon.classList.remove('fa-eye');
        toggleIcon.classList.add('fa-eye-slash');
      } else {
        passwordInput.type = 'password';
        toggleIcon.classList.remove('fa-eye-slash');
        toggleIcon.classList.add('fa-eye');
      }
    }

    function validatePassword() {
      const password = document.getElementById('password').value;
      const strengthText = document.getElementById('password-strength');
      const lengthIcon = document.getElementById('length-icon');
      const uppercaseIcon = document.getElementById('uppercase-icon');
      const lowercaseIcon = document.getElementById('lowercase-icon');
      const numberIcon = document.getElementById('number-icon');
      const specialIcon = document.getElementById('special-icon');

      [lengthIcon, uppercaseIcon, lowercaseIcon, numberIcon, specialIcon].forEach(icon => {
        icon.classList.remove('valid', 'invalid');
      });

      const hasLength = password.length >= 8;
      const hasUppercase = /[A-Z]/.test(password);
      const hasLowercase = /[a-z]/.test(password);
      const hasNumber = /[0-9]/.test(password);
      const hasSpecial = /[!@#$%^&*(),.?":{}|<>]/.test(password);

      updateIcon(lengthIcon, hasLength);
      updateIcon(uppercaseIcon, hasUppercase);
      updateIcon(lowercaseIcon, hasLowercase);
      updateIcon(numberIcon, hasNumber);
      updateIcon(specialIcon, hasSpecial);

      let strength = 0;
      if (hasLength) strength++;
      if (hasUppercase) strength++;
      if (hasLowercase) strength++;
      if (hasNumber) strength++;
      if (hasSpecial) strength++;

      if (password.length === 0) {
        strengthText.textContent = '';
        strengthText.className = 'password-strength';
      } else {
        switch (strength) {
          case 0:
          case 1:
            strengthText.textContent = 'Very Weak';
            strengthText.className = 'password-strength text-danger';
            break;
          case 2:
            strengthText.textContent = 'Weak';
            strengthText.className = 'password-strength text-warning';
            break;
          case 3:
            strengthText.textContent = 'Moderate';
            strengthText.className = 'password-strength text-info';
            break;
          case 4:
            strengthText.textContent = 'Strong';
            strengthText.className = 'password-strength text-primary';
            break;
          case 5:
            strengthText.textContent = 'Very Strong';
            strengthText.className = 'password-strength text-success';
            break;
        }
      }
    }

    function updateIcon(iconElement, isValid) {
      if (isValid) {
        iconElement.classList.add('valid');
        iconElement.classList.remove('invalid');
      } else {
        iconElement.classList.add('invalid');
        iconElement.classList.remove('valid');
      }
    }
     function validateRollNo() {
        const rollNoInput = document.getElementById('roleno');
        const errorElement = document.getElementById('rollno-error');
        const value = parseInt(rollNoInput.value);

        if (isNaN(value)) {
          errorElement.textContent = 'Please enter a valid number';
          rollNoInput.classList.add('is-invalid');
          return false;
        } else if (value < 1) {
          errorElement.textContent = 'Role number must be at least 1';
          rollNoInput.classList.add('is-invalid');
          return false;
        } else if (value > 50) {
          errorElement.textContent = 'Role number cannot exceed 50';
          rollNoInput.classList.add('is-invalid');
          return false;
        } else {
          errorElement.textContent = '';
          rollNoInput.classList.remove('is-invalid');
          return true;
        }
      }

    function validateEditForm(event) {
      event.preventDefault();

      const name = document.getElementById('name');
      const userClass = document.getElementById('class');
      const password = document.getElementById('password');
       const rollNo = document.getElementById('roleno');

      let isValid = true;

      const nameRegex = /^[a-zA-Z ]+$/;

      if (!name.value.trim()) {
        setError(name, 'Name is required.');
        isValid = false;
      } else if (!nameRegex.test(name.value)) {
        setError(name, 'Name must contain only letters and spaces.');
        isValid = false;
      } else {
        clearError(name);
      }

      if (!userClass.value.trim() || isNaN(userClass.value) || userClass.value <= 0) {
        setError(userClass, 'Class must be a positive number.');
        isValid = false;
      } else {
        clearError(userClass);
      }

      const passwordValue = password.value;
      if (!passwordValue.trim()) {
        setError(password, 'Password is required.');
        isValid = false;
      } else if (passwordValue.length < 8) {
        setError(password, 'Password must be at least 8 characters.');
        isValid = false;
      } else if (!/[A-Z]/.test(passwordValue)) {
        setError(password, 'Password must contain at least one uppercase letter.');
        isValid = false;
      } else if (!/[a-z]/.test(passwordValue)) {
        setError(password, 'Password must contain at least one lowercase letter.');
        isValid = false;
      } else if (!/[0-9]/.test(passwordValue)) {
        setError(password, 'Password must contain at least one number.');
        isValid = false;
      } else if (!/[!@#$%^&*(),.?":{}|<>]/.test(passwordValue)) {
        setError(password, 'Password must contain at least one special character.');
        isValid = false;
      } else {
        clearError(password);
      }

      if (!validateRollNo()) {
        isValid = false;
      }

    
      if (isValid) {
        event.target.submit();
      }
    }

    function setError(element, message) {
      const parent = element.closest('.mb-4');
      let errorElement = parent.querySelector('.error-message');
      if (!errorElement) {
        errorElement = document.createElement('div');
        errorElement.classList.add('error-message');
        parent.appendChild(errorElement);
      }
      errorElement.textContent = message;
      element.classList.add('is-invalid');
    }

    function clearError(element) {
      const parent = element.closest('.mb-4');
      const errorElement = parent.querySelector('.error-message');
      if (errorElement) {
        errorElement.remove();
      }
      element.classList.remove('is-invalid');
    }
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>